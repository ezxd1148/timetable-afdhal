{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{workspaceRoot}/apps/web/.next/**",
      "!{workspaceRoot}/apps/web/out/**",
      "!{workspaceRoot}/apps/server/dist/**",
      "!{workspaceRoot}/packages/db/dist/**",
      "!{workspaceRoot}/packages/db/local.db*",
      "!{workspaceRoot}/packages/db/prisma/generated/**",
      "!{workspaceRoot}/.alchemy/**",
      "!{workspaceRoot}/.wrangler/**",
      "!{workspaceRoot}/**/.wrangler/**",
      "!{workspaceRoot}/apps/web/.open-next/**",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["default", "^default"]
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "continuous": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "destroy": {
      "cache": false
    }
  },
  "analytics": true
}
